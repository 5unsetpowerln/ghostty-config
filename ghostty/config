# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

font-family = Iosevka Nerd Font
theme = Tomorrow Night
window-theme = ghostty
gtk-tabs-location = top
gtk-custom-css = style.css
unfocused-split-opacity = 0.35
command = tmux

# tmux-like pain split
keybind = ctrl+s>-=new_split:down
keybind = ctrl+s>shift+-=new_split:down
keybind = ctrl+s>\=new_split:right
keybind = ctrl+s>shift+\=new_split:right

# tmux-like pane navigation
keybind = ctrl+s>h=goto_split:left
keybind = ctrl+s>j=goto_split:down
keybind = ctrl+s>k=goto_split:up
keybind = ctrl+s>l=goto_split:right
keybind = ctrl+s>ctrl+h=goto_split:left
keybind = ctrl+s>ctrl+j=goto_split:down
keybind = ctrl+s>ctrl+k=goto_split:up
keybind = ctrl+s>ctrl+l=goto_split:right

# tmux-like pane resize (repeatable via the "resize" key table)
keybind = ctrl+s>shift+h=resize_split:left,40
keybind = chain=activate_key_table:resize
keybind = ctrl+s>shift+j=resize_split:down,40
keybind = chain=activate_key_table:resize
keybind = ctrl+s>shift+k=resize_split:up,40
keybind = chain=activate_key_table:resize
keybind = ctrl+s>shift+l=resize_split:right,40
keybind = chain=activate_key_table:resize

keybind = resize/shift+h=resize_split:left,40
keybind = resize/shift+j=resize_split:down,40
keybind = resize/shift+k=resize_split:up,40
keybind = resize/shift+l=resize_split:right,40
# Pressing Shift alone would hit catch_all and leave the table, so swallow it
keybind = resize/shift+shift_left=ignore
keybind = resize/shift+shift_right=ignore
# Any other key leaves the table and is still sent to the terminal
keybind = resize/unconsumed:catch_all=deactivate_key_table

# tmux-like tabs
keybind = ctrl+s>c=new_tab
keybind = ctrl+s>n=next_tab

# tmux-like pane swap (swaps the tmux sessions of the two panes, see ~/.tmux.conf)
keybind = ctrl+s>shift+[=csi:5000~
keybind = chain=goto_split:previous
keybind = ctrl+s>shift+]=csi:5000~
keybind = chain=goto_split:next
